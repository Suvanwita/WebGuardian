{
  "manifest_version": 3,
  "name": "WebGuardian",
  "version": "0.1.0",
  "description": "A local-first Chrome extension for proactive security monitoring and protection.",
  "permissions": [
    "storage",
    "webNavigation",
    "webRequest",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/phishing.js",
        "content/loginDetector.js",
        "content/trackerDetector.js",
        "content/passwordChecker.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules/suspiciousKeywords.json",
        "rules/trackerList.json",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
